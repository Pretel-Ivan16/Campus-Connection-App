# ========================================
# CampusConnect Backend - Environment Config
# ========================================
# 
# IMPORTANTE: 
# 1. Copia este archivo a .env en el directorio Backend/
# 2. Reemplaza los valores de ejemplo con tus datos reales
# 3. NUNCA subas el archivo .env a GitHub (debería estar en .gitignore)
#
# ========================================

# Puerto donde se ejecutará el servidor
# Default: 8080
PORT=8080

# URL de conexión a MongoDB
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/nombre-base-datos
# O para MongoDB local: mongodb://localhost:27017/nombre-base-datos
MONGODB_URL=mongodb+srv://usuario:contraseña@tu-cluster.mongodb.net/campus-connection-app

# Secreto para firmar JWT (tokens)
# Genera uno seguro: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo 32 caracteres para seguridad
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui_minimo_32_caracteres

# Credenciales de Gmail para envío de emails
# IMPORTANTE: Usar contraseña de aplicación de Google, no la contraseña de la cuenta
# https://myaccount.google.com/apppasswords
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion_gmail

# (Opcional) Config SMTP explícita para deploy
# Gmail recomendado: host smtp.gmail.com, puerto 587 (TLS STARTTLS)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# (Opcional) Reintentos y timeouts de envío
EMAIL_SEND_RETRIES=2
EMAIL_SEND_TIMEOUT_MS=12000
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_GREETING_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=10000

# (Opcional) Proveedor SMTP backup para fallback automático
# Ejemplo Brevo: smtp-relay.brevo.com / 587 / false
EMAIL_BACKUP_HOST=
EMAIL_BACKUP_PORT=587
EMAIL_BACKUP_SECURE=false
EMAIL_BACKUP_USER=
EMAIL_BACKUP_PASS=

# Modo contingencia (NO recomendado en producción estable)
# true  => desactiva verificación por email (auto-verifica)
# false => mantiene verificación por email (recomendado)
DISABLE_EMAIL_VERIFICATION=false

# (Opcional) URL del frontend para verificación de email
# Si no está definida, usa valor por defecto
FRONTEND_URL=http://localhost:3000