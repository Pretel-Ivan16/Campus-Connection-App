{
  "name": "campus-connection",
  "version": "1.0.0",
  "main": "Backend/src/server.js",
  "scripts": {
    "start": "node Backend/src/server.js",
    "dev": "nodemon --exec \"node --env-file=Backend/.env\" Backend/src/server.js",
    "build": "npm --prefix Backend install && npm --prefix Frontend run build",
    "render-build": "npm --prefix Backend install"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "axios": "^1.16.0",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
